---
import ReplyForm from "./ReplyForm.astro";
import { renderComment } from "../lib/renderComment";

interface CommentType {
  id: number;
  postSlug: string;
  name: string;
  message: string;
  createdAt: Date;
  parentId: number | null;
  email?: string;
  children?: CommentType[];
}

interface Props {
  comment: CommentType;
}

const { comment } = Astro.props as Props;
const renderedMessage = await renderComment(comment.message);
const renderedChildren = await Promise.all(
  (comment.children ?? []).map((child) => renderComment(child.message)),
);
---

<div class="p-4 bg-header-image-bg-light rounded comic-comment">
    <div class="font-bold">{comment.name}</div>
    <div class="text-gray-600 text-sm">
        {comment.createdAt?.toLocaleDateString('en-US', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: true,  // Use 12-hour format (AM/PM)
                      })}
    </div>
    <div class="mt-2 comment-content" set:html={renderedMessage}></div>

    <details class="text-gray-600 text-xs">
      <summary>Reply</summary>
      <ReplyForm postSlug={comment.postSlug} parentId={comment.id} starter={comment.name} />
    </details>

    {comment.children?.length ? (
    <div class="pl-6 border-l-2 border-gray-300 mt-4 comic-comment__reply">
        {comment.children.map((child, childIndex) => (
        <div>
            <div class="font-bold">{child.name}</div>
            <div class="text-gray-600 text-sm">
            {child.createdAt?.toLocaleDateString('en-US', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit',
              hour12: true,  // Use 12-hour format (AM/PM)
            })}
            </div>
            <div class="mt-2 comment-content" set:html={renderedChildren[childIndex]}></div>

        </div>
        ))}
    </div>
    ) : null}
</div>
