---
import { and, db, Comment, desc, eq, inArray, isNull, or } from "astro:db";
import CommentItem from "./CommentItem.astro";

interface CommentType {
  id: number;
  postSlug: string;
  name: string;
  message: string;
  createdAt: Date;
  parentId: number | null;
  status?: string | null;
  email?: string;
  children?: CommentType[];
}

interface Props {
  postSlug: string;
}

const PAGE_SIZE = 10;
const { postSlug } = Astro.props as Props;
const requestedPage = Number(Astro.url.searchParams.get("commentsPage") ?? "1");
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

// Null status preserves comments created before moderation was introduced.
const approved = or(eq(Comment.status, "approved"), isNull(Comment.status), eq(Comment.status, ""));
const roots = await db
  .select({ id: Comment.id, postSlug: Comment.postSlug, name: Comment.name, message: Comment.message, createdAt: Comment.createdAt, parentId: Comment.parentId, status: Comment.status })
  .from(Comment)
  .where(and(eq(Comment.postSlug, postSlug), or(eq(Comment.parentId, -1), isNull(Comment.parentId)), approved))
  .orderBy(desc(Comment.createdAt))
  .limit(PAGE_SIZE + 1)
  .offset((page - 1) * PAGE_SIZE) as CommentType[];

const hasNextPage = roots.length > PAGE_SIZE;
const visibleRoots = roots.slice(0, PAGE_SIZE);
const rootIds = visibleRoots.map((comment) => comment.id);
const replies = rootIds.length
  ? await db
      .select({ id: Comment.id, postSlug: Comment.postSlug, name: Comment.name, message: Comment.message, createdAt: Comment.createdAt, parentId: Comment.parentId, status: Comment.status })
      .from(Comment)
      .where(and(eq(Comment.postSlug, postSlug), inArray(Comment.parentId, rootIds), approved))
      .orderBy(desc(Comment.createdAt)) as CommentType[]
  : [];

const repliesByParent = new Map<number, CommentType[]>();
for (const reply of replies) {
  const current = repliesByParent.get(reply.parentId as number) ?? [];
  current.unshift(reply);
  repliesByParent.set(reply.parentId as number, current);
}

const nestedComments = visibleRoots.map((comment) => ({
  ...comment,
  children: repliesByParent.get(comment.id) ?? [],
}));

const pageUrl = (nextPage: number) => {
  const url = new URL(Astro.url);
  if (nextPage <= 1) url.searchParams.delete("commentsPage");
  else url.searchParams.set("commentsPage", String(nextPage));
  return `${url.pathname}${url.search}`;
};
---

<div class="space-y-4">
  {nestedComments.map((comment) => (
    <CommentItem comment={comment} />
  ))}
</div>

{(page > 1 || hasNextPage) && (
  <nav class="flex justify-between mt-6" aria-label="Comments pagination">
    {page > 1 ? <a href={pageUrl(page - 1)}>Newer comments</a> : <span></span>}
    {hasNextPage && <a href={pageUrl(page + 1)}>Older comments</a>}
  </nav>
)}
