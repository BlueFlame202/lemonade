---
import CommentList from "./CommentList.astro";
import CommentForm from "./CommentForm.astro";

import type { Session } from '@auth/core/types';
import { Auth, SignIn, SignOut } from 'auth-astro/components';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);

interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
---

<section class="comments-section comic-panel comic-panel--yellow">
    <h2 class="comic-section-title">Comments</h2>
    <div>
    {session ? (
        <p>Welcome {session.user?.name}. Comments are moderated before they appear. Signing in records your Google email with this comment for identification. It is stored privately, not displayed, and not used for notifications.</p>
    ) : (
        <p>Not signed in. Comments are moderated before they appear. Sign in with Google to associate your email with the comment for identification. Anonymous comments do not store an email.</p>
    )}

    <Auth>
      {(session: Session) => {
        if (session) {
          return (
              <SignOut>
                <a class="px-4 py-2 bg-tertiary text-white rounded break-all">
                  Sign Out
                </a>
              </SignOut>
          );
        } else {
          return <SignIn provider="google">
                  <a class="px-4 py-2 bg-tertiary text-white rounded break-all">
                  Sign In
                  </a>
                </SignIn>;
        }
      }}
    </Auth>
    <br/>
    </div>

    <div>
        <CommentForm postSlug={postSlug} server:defer />
        <CommentList postSlug={postSlug} server:defer />
    </div>
</section>
