---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import Navbar from "../components/Navbar";
import Footbar from "../components/Footbar.astro";
const { title, image, author, date } = Astro.props;

import '@fontsource/bitter'
import "@fontsource/barrio";
import '../styles/globals.css'
import '../styles/bstyles.css'
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/img/icons/lemonade-mark/lemonade-circle.png" />
        <link rel="apple-touch-icon" href="/img/icons/lemonade-mark/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" 
              href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" 
              integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" 
              crossorigin="anonymous">
		<title>{title}</title>
	</head>
	<body class="comic-site">
        <main class="comic-page">
        <Navbar active="blog" client:load />
        <div class="container-fluid flex flex-wrap bg-soul pb-8 px-2 md:px-6">
            <div class="w-full">
            <!-- <div class="order-2 md:order-1 w-full md:w-1/4 gx-5">
            <NewsWidget></NewsWidget>
            </div> -->
            <!-- <div class="order-1 md:order-2 w-full md:w-3/4 gx-5"> -->
                <article class="comic-story w-full">
                    <header class="comic-hero">
                    <div class="cover-image mt-4 rounded-lg" style={{ backgroundImage: `url(${image})` }}></div>
                    <h1 class="display-1 mt-5 comic-title">{title}</h1>
                    <p id="frontmatter"><b>{date}</b><br/>
                        <b>By {author}</b></p>
                    </header>
                    <slot />
                </article>
            </div>
            <br />
        </div>
        </main>
        <Footbar></Footbar>
        <Analytics />
        <SpeedInsights />
    </body>
</html>
